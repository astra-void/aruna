{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleDetection": "force",
    "moduleResolution": "node",
    "declaration": false,
    "declarationMap": false,
    "noLib": true,
    "outDir": "out",
    "rootDir": "src",
    "jsx": "preserve",
    "verbatimModuleSyntax": false,
    "typeRoots": [
      "./node_modules",
      "./node_modules/@rbxts"
    ],
    "types": [
      "@rbxts/types",
      "@rbxts/compiler-types"
    ],
    "target": "ESNext",
    "downlevelIteration": true,
    "paths": {
      "$aruna/actions/client": ["./src/.aruna/shared/actions.client.generated.ts"],
      "$aruna/actions/server": ["./src/.aruna/server/actions.server.generated.ts"],
      "$aruna/signals": ["./src/.aruna/shared/signals.generated.ts"],
      "aruna/client": ["./src/.aruna/shared/runtime/client.ts"],
      "aruna/server": ["./src/.aruna/shared/runtime/server.ts"],
      "aruna/roblox": ["./src/.aruna/shared/runtime/roblox.ts"],
      "aruna/schema": ["./src/.aruna/shared/runtime/schema.ts"],
      "aruna/testing": ["./src/.aruna/shared/runtime/testing.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/.aruna/**/*.ts",
    "src/.aruna/**/*.tsx"
  ],
  "exclude": [
    "aruna.config.ts",
    "dist",
    "node_modules",
    "out"
  ]
}
