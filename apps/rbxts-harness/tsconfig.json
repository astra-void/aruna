{
  "extends": [
    "../../tsconfig.base.json",
    "./src/.aruna/tsconfig.aruna.json"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "module": "commonjs",
    "moduleDetection": "force",
    "moduleResolution": "node",
    "declaration": false,
    "declarationMap": false,
    "noLib": true,
    "outDir": "out",
    "rootDir": "src",
    "jsx": "preserve",
    "verbatimModuleSyntax": false,
    "typeRoots": [
      "./node_modules",
      "./node_modules/@rbxts"
    ],
    "types": [
      "@rbxts/types",
      "@rbxts/compiler-types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/.aruna/**/*.ts",
    "src/.aruna/**/*.tsx"
  ],
  "exclude": [
    "aruna.config.ts",
    "dist",
    "node_modules",
    "out"
  ]
}
