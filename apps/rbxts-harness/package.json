{
  "name": "@arunajs/rbxts-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "aruna:build": "pnpm --filter aruna build && pnpm --filter aruna aruna build --project .",
    "rbxts:compile:layout": "tsx scripts/layout-rbxts-output.ts",
    "aruna:layout": "pnpm rbxts:compile:layout",
    "typecheck": "pnpm aruna:build && tsc -p tsconfig.typecheck.json --noEmit",
    "rbxtsc": "pnpm aruna:build && pnpm rbxts:compile:layout",
    "build": "pnpm typecheck && pnpm rbxtsc",
    "check": "pnpm typecheck",
    "verify:layout": "tsx scripts/verify-layout.ts",
    "test": "pnpm verify:layout"
  },
  "dependencies": {
    "aruna": "workspace:*"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.924",
    "roblox-ts": "3.0.0",
    "typescript": "5.5.3"
  }
}
