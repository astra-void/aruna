{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!test/**", "!**/*.test.ts", "!docs/**", "!**/*.md"],
      "outputs": ["dist/**", "src/.aruna/**"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "@arunajs/compiler#test": {
      "dependsOn": ["build", "^build", "@arunajs/aruna#build", "create-aruna-app#build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "dependsOn": ["^build"]
    }
  }
}
