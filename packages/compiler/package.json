{
  "name": "@arunajs/compiler",
  "version": "0.5.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astra-void/aruna.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build:native": "tsx scripts/build-native-target.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:native": "tsx scripts/verify-native-target.ts",
    "test": "pnpm exec vitest run",
    "test:release": "pnpm exec vitest run test/build-native-target.test.ts test/native-build.test.ts test/native-loader.test.ts test/native-staging.test.ts test/release.test.ts",
    "lint": "pnpm exec oxlint src scripts test",
    "lint:fix": "pnpm exec oxlint src scripts test --fix"
  },
  "dependencies": {
    "@arunajs/core": "workspace:*",
    "typescript": "^5.9.3"
  }
}
