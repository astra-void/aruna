export type BuyItemInput = { itemId: string; };

export type BuyItemOutput = void;

export const buyItem = (input: BuyItemInput, options?: ActionInvokeOptions): Promise<BuyItemOutput> => {
  return invokeAction("shop.buyItem", input, options) as Promise<BuyItemOutput>;
};

