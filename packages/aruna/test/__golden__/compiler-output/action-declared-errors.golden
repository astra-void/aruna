// Generated by Aruna. Do not edit by hand.
// Source: Aruna action manifest v1

import { invokeAction, type ActionInvokeOptions, type ActionStub } from "aruna/client";

export type BrowseInput = unknown;

export type BrowseOutput = string[];

export const browse = (input?: BrowseInput, options?: ActionInvokeOptions): Promise<BrowseOutput> => {
  return invokeAction("shop.browse", input, options) as Promise<BrowseOutput>;
};

export type PurchaseItemInput = { itemId: string; };

export type PurchaseItemOutput = { ok: boolean; };

export type PurchaseItemErrors = { readonly NotEnoughCoins: undefined; readonly OutOfStock: { itemId: string; restockIn: number; }; };

export const purchaseItem: ActionStub<PurchaseItemInput, PurchaseItemOutput, PurchaseItemErrors> = (input, options) => {
  return invokeAction("shop.purchaseItem", input, options) as Promise<PurchaseItemOutput>;
};

