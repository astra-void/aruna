// Generated by Aruna. Do not edit by hand.
// Source: Aruna entry manifest v1

import { createClientApp } from "aruna/client";
import { createActionInvoker, createSignalSubscriber } from "aruna/roblox";
import { signals } from "$aruna/signals";
import * as hooks from "../../client";

const app = createClientApp({
  transport: createActionInvoker({ createRequestId: hooks.createRequestId }),
  signals,
  createSubscriber: createSignalSubscriber,
});

hooks.onStart(app);

