// Generated by Aruna. Do not edit by hand.
// Source: Aruna entry manifest v1

import { createServerApp } from "aruna/server";
import { createSignalPublisher, robloxRemoteEvent } from "aruna/roblox";
import { actions, defaultRateLimit } from "$aruna/actions/server";
import { signals } from "$aruna/signals";
import * as hooks from "../../server";

const app = createServerApp<Player>({
  actions,
  defaultRateLimit,
  transport: robloxRemoteEvent(),
  signals,
  createPublisher: createSignalPublisher,
  middleware: hooks.middleware,
  onError: hooks.onError,
});

hooks.configure(app);

