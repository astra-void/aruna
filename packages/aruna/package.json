{
  "name": "aruna",
  "version": "0.0.1",
  "private": false,
  "bin": {
    "aruna": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./client-runtime": {
      "types": "./dist/client-runtime.d.ts",
      "import": "./dist/client-runtime.js"
    },
    "./server-runtime": {
      "types": "./dist/server-runtime.d.ts",
      "import": "./dist/server-runtime.js"
    },
    "./server-app": {
      "types": "./dist/server-app.d.ts",
      "import": "./dist/server-app.js"
    },
    "./roblox-runtime": {
      "types": "./dist/roblox-runtime.d.ts",
      "import": "./dist/roblox-runtime.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "test": "pnpm exec vitest run",
    "lint": "pnpm exec oxlint src test",
    "lint:fix": "pnpm exec oxlint src test --fix",
    "aruna": "node ./dist/cli.js"
  },
  "dependencies": {
    "@arunajs/compiler": "workspace:*",
    "@arunajs/core": "workspace:*",
    "commander": "^14.0.3",
    "gradient-string": "^3.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.920"
  }
}
