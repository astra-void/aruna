{
  "name": "aruna",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "aruna": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client-runtime": {
      "types": "./dist/client-runtime.d.ts",
      "import": "./dist/client-runtime.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --dir ../.. exec vitest run --root packages/aruna",
    "lint": "pnpm exec oxlint src test",
    "lint:fix": "pnpm exec oxlint src test --fix",
    "aruna": "node ./dist/cli.js"
  },
  "dependencies": {
    "@arunajs/compiler": "workspace:*",
    "@arunajs/core": "workspace:*",
    "commander": "^14.0.3",
    "gradient-string": "^3.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
