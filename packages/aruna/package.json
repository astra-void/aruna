{
  "name": "@arunajs/aruna",
  "version": "0.1.0",
  "private": false,
  "bin": {
    "aruna": "./dist/cli.js"
  },
  "files": [
    "dist",
    "roblox",
    "*.js",
    "*.d.ts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "import": "./server.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "import": "./client.js"
    },
    "./client-runtime": {
      "types": "./client-runtime.d.ts",
      "import": "./client-runtime.js"
    },
    "./server-runtime": {
      "types": "./server-runtime.d.ts",
      "import": "./server-runtime.js"
    },
    "./server-app": {
      "types": "./server-app.d.ts",
      "import": "./server-app.js"
    },
    "./roblox-runtime": {
      "types": "./roblox-runtime.d.ts",
      "import": "./roblox-runtime.js"
    },
    "./runtime": {
      "types": "./runtime.d.ts",
      "import": "./runtime.js"
    },
    "./schema": {
      "types": "./schema.d.ts",
      "import": "./schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.shims.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json --noEmit && tsc -p tsconfig.roblox.json --noEmit",
    "test": "pnpm exec vitest run",
    "lint": "pnpm exec oxlint src test",
    "lint:fix": "pnpm exec oxlint src test --fix",
    "aruna": "node ./dist/cli.js"
  },
  "dependencies": {
    "@arunajs/compiler": "workspace:*",
    "@arunajs/core": "workspace:*",
    "commander": "^15.0.0",
    "gradient-string": "^3.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.924"
  }
}
