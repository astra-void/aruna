{
  "name": "@arunajs/aruna",
  "version": "0.6.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astra-void/aruna.git"
  },
  "bin": {
    "aruna": "./bin/aruna.js"
  },
  "files": [
    "dist",
    "bin",
    "roblox",
    "lune",
    "docs",
    "llms.txt",
    "*.d.ts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./server.d.ts"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./roblox": {
      "types": "./roblox.d.ts"
    },
    "./schema": {
      "types": "./schema.d.ts"
    },
    "./testing": {
      "types": "./testing.d.ts"
    },
    "./ui": {
      "types": "./ui.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.native-types.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.roblox.json --noEmit",
    "test": "pnpm exec vitest run",
    "lint": "pnpm exec oxlint src test",
    "lint:fix": "pnpm exec oxlint src test --fix",
    "aruna": "node ./dist/cli.js"
  },
  "dependencies": {
    "@arunajs/compiler": "workspace:*",
    "@arunajs/core": "workspace:*",
    "commander": "^15.0.0",
    "gradient-string": "^3.0.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.924"
  }
}
