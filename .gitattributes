# Auto detect text files and perform LF normalization
* text=auto

# Compared byte for byte against generated output, which is always LF: keep them
# LF on every platform's checkout. Fixtures are also the compiler's inputs, and
# the spans it reports are byte offsets into them, so a CRLF checkout on Windows
# shifts every expected span.
/api/*.d.ts text eol=lf
/packages/aruna/test/__golden__/** text eol=lf
/fixtures/** text eol=lf

# The checked-in launcher ships as is (dist/ is emitted LF anyway). A CRLF
# shebang line breaks it on Unix (`env: 'node\r'`), and pnpm pack refuses to
# pack such a bin at all (ERR_PNPM_BIN_CRLF).
/packages/aruna/bin/** text eol=lf
