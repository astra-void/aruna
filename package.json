{
  "name": "aruna-workspace",
  "private": true,
  "scripts": {
    "build:native": "tsx packages/compiler/scripts/build-native-target.ts",
    "build": "pnpm build:native && turbo run build",
    "check": "pnpm build:native && turbo run check",
    "test": "pnpm build:native && turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "pnpm build:native && turbo run typecheck",
    "release:prepare": "tsx scripts/release.ts prepare",
    "release:build-native": "tsx scripts/release.ts build-native",
    "release:pack": "tsx scripts/release.ts pack",
    "release:publish": "tsx scripts/release.ts publish",
    "release:dry-run": "tsx scripts/release.ts publish --dry-run",
    "aruna": "pnpm --filter aruna aruna",
    "harness:rbxts": "pnpm --filter @arunajs/rbxts-harness typecheck",
    "harness:rbxts:compile": "pnpm --filter @arunajs/rbxts-harness rbxtsc",
    "harness:package": "pnpm --filter @arunajs/package-consumption-harness build",
    "package-consumption": "pnpm --filter @arunajs/package-consumption-harness build",
    "verify:package-consumption": "tsx scripts/verify-package-consumption.ts",
    "verify:package-consumption:keep-temp": "tsx scripts/verify-package-consumption.ts --keep-temp"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "commander": "^15.0.0",
    "gradient-string": "^3.0.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "picocolors": "^1.1.1",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.5.1"
}
