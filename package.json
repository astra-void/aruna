{
  "name": "aruna-workspace",
  "private": true,
  "scripts": {
    "build:native": "tsx packages/compiler/scripts/build-native-target.ts",
    "build": "pnpm build:native && turbo run build",
    "check": "pnpm build:native && turbo run check",
    "test": "pnpm build:native && turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "pnpm build:native && turbo run typecheck",
    "release:prepare": "tsx scripts/release.ts prepare",
    "release:pack": "tsx scripts/release.ts pack",
    "release:publish": "tsx scripts/release.ts publish",
    "release:dry-run": "tsx scripts/release.ts publish --dry-run",
    "aruna": "pnpm --filter aruna aruna",
    "harness:rbxts": "pnpm --filter @arunajs/rbxts-harness typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "commander": "^14.0.3",
    "gradient-string": "^3.0.0",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "picocolors": "^1.1.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.14",
    "typescript": "^5.8.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@11.1.2"
}
